# Copy to .env and fill in. NEVER commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# SQLite for local dev; use a postgres:// URL in production
DATABASE_URL=sqlite:///db.sqlite3
# Dev only: load Tailwind from CDN so pages are styled before you run the build
USE_TAILWIND_CDN=True
# Storefront
DELIVERY_FEE=150.00
FREE_DELIVERY_THRESHOLD=2000.00
STORE_PHONE=
STORE_ADDRESS=
CONTACT_EMAIL=
# WhatsApp number as country code + digits, with no spaces or plus sign.
CONTACT_WHATSAPP=
CONTACT_BUSINESS_HOURS=
# Optional iframe embed URL for the verified store location. Leave blank until configured.
CONTACT_MAP_EMBED_URL=
CONTACT_FACEBOOK=
CONTACT_INSTAGRAM=
CONTACT_X=
CONTACT_YOUTUBE=
# Outgoing mail used by the contact form. Set credentials for your mail provider.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=
# About page figures: replace these preview values with verified business data before publishing.
ABOUT_HAPPY_CUSTOMERS=10K+
ABOUT_PRODUCTS_AVAILABLE=5K+
ABOUT_ON_TIME_DELIVERY=99%
ABOUT_FRESH_NATURAL=100%
