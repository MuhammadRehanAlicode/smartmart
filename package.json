{
  "name": "smartmart-ui",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./static/src/input.css -o ./static/dist/output.css --minify",
    "watch:css": "tailwindcss -i ./static/src/input.css -o ./static/dist/output.css --watch",
    "build:js": "esbuild static/src/barcode-camera.js --bundle --format=iife --global-name=SmartMartBarcodeCamera --outfile=static/dist/barcode-camera.js"
  },
  "dependencies": { "@zxing/browser": "^0.1.5" },
  "devDependencies": { "esbuild": "^0.25.0", "tailwindcss": "^3.4.0" }
}
